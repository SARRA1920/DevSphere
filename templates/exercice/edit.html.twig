{% extends 'base.html.twig' %}

{% block title %}Modifier l'exercice{% endblock %}

{% block content %}
    <div class="container mt-4">
        <h1>Modifier l'exercice</h1>

        {{ include('exercice/_form.html.twig') }}

        <div class="mt-3">
            <a href="{{ path('app_exercice_list') }}" class="btn btn-secondary">Retour à la liste</a>

            <form method="post" action="{{ path('app_exercice_delete', {'id': exercice.id}) }}" style="display: inline-block" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet exercice ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ exercice.id) }}">
                <button class="btn btn-danger">Supprimer</button>
            </form>
        </div>
    </div>
{% endblock %}
