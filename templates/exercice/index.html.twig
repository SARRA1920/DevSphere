{% extends 'base.html.twig' %}

{% block title %}Liste des exercices{% endblock %}

{% block content %}
    <div class="container mt-4">
        <h1>Liste des exercices</h1>

        <a href="{{ path('app_exercice_new') }}" class="btn btn-success mb-3">Créer un nouvel exercice</a>

        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Titre</th>
                    <th>Niveau de difficulté</th>
                    <th>Note minimale</th>
                    <th>Temps estimé</th>
                    <th>Type</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for exercice in exercices %}
                <tr>
                    <td>{{ exercice.id }}</td>
                    <td>{{ exercice.titre }}</td>
                    <td>{{ exercice.niveauDifficulte }}</td>
                    <td>{{ exercice.noteMinimale }}</td>
                    <td>{{ exercice.tempsEstime }} min</td>
                    <td>{{ exercice.type }}</td>
                    <td>
                        <a href="{{ path('app_exercice_show', {'id': exercice.id}) }}" class="btn btn-info btn-sm">Voir</a>
                        <a href="{{ path('app_exercice_edit', {'id': exercice.id}) }}" class="btn btn-primary btn-sm">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">Aucun exercice trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}