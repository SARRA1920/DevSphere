{% extends 'base.html.twig' %}

{% block title %}Ajouter un Exercice{% endblock %}

{% block carousel %}{% endblock %}

{% block content %}
    <div class="container mt-4">
        <h1>Ajouter un Exercice</h1>

        {% if app.session.flashBag.has('success') %}
            <div class="alert alert-success">
                {{ app.session.flashBag.get('success')[0] }}
            </div>
        {% endif %}
        {% if app.session.flashBag.has('error') %}
            <div class="alert alert-danger">
                {{ app.session.flashBag.get('error')[0] }}
            </div>
        {% endif %}

        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
            {{ form_widget(form, {'attr': {'class': 'form-control'}}) }}
            <button class="btn btn-success mt-3" type="submit">Ajouter</button>
        {{ form_end(form) }}

        <a href="{{ path('app_exercice_list') }}" class="btn btn-secondary mt-2">Retour à la liste</a>
    </div>
{% endblock %}
