{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block content %}
<div class="login-container">
    <div class="login-content">
        <div class="login-form">
            <div class="illustration">
                <img src="{{ asset('img/logo.png') }}" alt="DevSphere Logo">
            </div>

            <form action="{{ path('app_login') }}" method="post" class="form-login">
                {% if error %}
                    <div class="alert alert-error">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <div class="form-group">
                    <label for="username">
                        <i class="fas fa-envelope"></i>
                    </label>
                    <input type="email" id="username" name="_username" value="{{ last_username }}" placeholder="Your Email" required autofocus>
                </div>

                <div class="form-group">
                    <label for="password">
                        <i class="fas fa-lock"></i>
                    </label>
                    <input type="password" id="password" name="_password" placeholder="Password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="form-check mb-3">
                    <input type="checkbox" id="remember_me" name="_remember_me" class="form-check-input" checked>
                    <label class="form-check-label" for="remember_me">Remember me</label>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-login">Log in</button>
                    <a href="{{ path('app_signup') }}" class="btn-signup">Don't have an account?</a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
.login-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f8f9fa;
    padding: 2rem;
}

.login-content {
    background: white;
    border-radius: 20px;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    width: 100%;
    max-width: 900px;
    overflow: hidden;
}

.login-form {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.illustration {
    margin-bottom: 2rem;
    max-width: 400px;
}

.illustration img {
    width: 100%;
    height: auto;
}

.form-login {
    width: 100%;
    max-width: 400px;
}

.form-group {
    position: relative;
    margin-bottom: 1.5rem;
}

.form-group label {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: #6c757d;
}

.form-group input {
    width: 100%;
    padding: 12px 40px;
    border: 1px solid #e0e0e0;
    border-radius: 25px;
    font-size: 1rem;
    transition: all 0.3s ease;
}

.form-group input:focus {
    border-color: #00bcd4;
    box-shadow: 0 0 0 2px rgba(0, 188, 212, 0.2);
    outline: none;
}

.form-check {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
}

.form-check-input {
    margin-left: -1.5rem;
    margin-top: 0.2rem;
}

.form-check-label {
    color: #6c757d;
    font-size: 0.9rem;
    cursor: pointer;
}

.alert {
    width: 100%;
    margin-bottom: 1rem;
    padding: 1rem;
    border-radius: 10px;
    text-align: center;
}

.alert-error {
    background-color: #f8d7da;
    border-color: #f5c6cb;
    color: #721c24;
}

.form-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    margin-top: 2rem;
}

.btn-login {
    background: #00bcd4;
    color: white;
    border: none;
    padding: 12px 40px;
    border-radius: 25px;
    font-size: 1rem;
    cursor: pointer;
    width: 100%;
    transition: background 0.3s ease;
}

.btn-login:hover {
    background: #008c9e;
}

.btn-signup {
    color: #6c757d;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.3s ease;
}

.btn-signup:hover {
    color: #00bcd4;
}

@media (max-width: 768px) {
    .login-container {
        padding: 1rem;
    }
    
    .login-form {
        padding: 1.5rem;
    }
}
</style>
{% endblock %}
