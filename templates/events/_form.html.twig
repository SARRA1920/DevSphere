{{ form_start(form) }}

<div class="row">
    <br>
    <div class="col-12">
        {{ form_label(form.titre) }}
        {{ form_widget(form.titre, { 'attr': { 'class': 'form-control input-control' } }) }}
        <span class="text-danger">{{ form_errors(form.titre) }}</span>
    </div>
    <br>
    <div class="col-12">
        {{ form_label(form.type) }}
        {{ form_widget(form.type, { 'attr': { 'class': 'form-control input-control' } }) }}
        <span class="text-danger">{{ form_errors(form.type) }}</span>
    </div>
    <br>
    <div class="col-12">
        {{ form_label(form.capacity) }}
        {{ form_widget(form.capacity, { 'attr': { 'class': 'form-control input-control' } }) }}
        <span class="text-danger">{{ form_errors(form.capacity) }}</span>
    </div>
    <br>
    <div class="col-12">
        {{ form_label(form.date) }}
        {{ form_widget(form.date, { 'attr': { 'class': 'form-control input-control' } }) }}
        <span class="text-danger">{{ form_errors(form.date) }}</span>
    </div>
    <br>
    <div class="col-12">
        {{ form_label(form.location) }}
        {{ form_widget(form.location, { 'attr': { 'class': 'form-control input-control' } }) }}
        <span class="text-danger">{{ form_errors(form.location) }}</span>
    </div>
    <br>
    <div class="col-12 text-center mt-3">
        <button class="btn btn-success">{{ button_label|default('Save') }}</button>
    </div>
</div>

{{ form_end(form) }}
