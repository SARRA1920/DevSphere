{% extends 'base.html.twig' %}

{% block title %}Détails de la tentative{% endblock %}

{% block content %}
    <div class="container-fluid bg-primary py-5 mb-5 page-header">
        <div class="container py-5">
            <div class="row justify-content-center">
                <div class="col-lg-10 text-center">
                    <h1 class="display-3 text-white">Détails de la tentative</h1>
                </div>
            </div>
        </div>
    </div>

    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg border-0 rounded-lg">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <h6 class="m-0 font-weight-bold text-primary">Informations de la tentative</h6>
                        <a href="{{ path('admin_tentative_index') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Retour à la liste
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="info-box bg-light p-3 rounded shadow-sm mb-3">
                                    <h5 class="text-primary"><i class="fas fa-user me-2"></i>Utilisateur</h5>
                                    <p class="mb-0">{{ tentative.user.email }}</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-box bg-light p-3 rounded shadow-sm mb-3">
                                    <h5 class="text-primary"><i class="fas fa-book me-2"></i>Exercice</h5>
                                    <p class="mb-0">{{ tentative.exercice.titre }}</p>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="info-box bg-light p-3 rounded shadow-sm mb-3">
                                    <h5 class="text-primary"><i class="fas fa-star me-2"></i>Score</h5>
                                    <span class="badge {% if tentative.score >= tentative.exercice.noteMinimale %}bg-success{% else %}bg-danger{% endif %}">
                                        {{ tentative.score }}/20
                                    </span>
                                    <p class="mt-2 mb-0 text-muted">
                                        Note minimale requise : {{ tentative.exercice.noteMinimale }}/20
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-box bg-light p-3 rounded shadow-sm mb-3">
                                    <h5 class="text-primary"><i class="fas fa-check-circle me-2"></i>Statut</h5>
                                    <span class="badge {% if tentative.statue == 'reussi' %}bg-success{% else %}bg-danger{% endif %}">
                                        {{ tentative.statue|capitalize }}
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="info-box bg-light p-3 rounded shadow-sm">
                                    <h5 class="text-primary"><i class="fas fa-calendar me-2"></i>Date de la tentative</h5>
                                    <p class="mb-0">{{ tentative.date|date('d/m/Y') }}</p>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-center gap-2">
                            <a href="{{ path('admin_tentative_edit', {'id': tentative.id}) }}" class="btn btn-warning">
                                <i class="fas fa-edit me-2"></i>Modifier
                            </a>
                            <form method="post" action="{{ path('admin_tentative_delete', {'id': tentative.id}) }}" style="display: inline-block" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette tentative ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tentative.id) }}">
                                <button class="btn btn-danger">
                                    <i class="fas fa-trash me-2"></i>Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .info-box {
            transition: all 0.3s ease;
        }
        .info-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15);
        }
        .badge {
            font-size: 0.875rem;
            padding: 0.5em 1em;
        }
        .page-header {
            position: relative;
            overflow: hidden;
        }
        .page-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.2);
            z-index: 1;
        }
        .page-header .container {
            position: relative;
            z-index: 2;
        }
    </style>
{% endblock %}
