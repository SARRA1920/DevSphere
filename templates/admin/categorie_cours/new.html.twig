{% extends 'admin/base.html.twig' %}

{% block title %}New Category - Admin{% endblock %}

{% block content %}
    <div class="container-fluid">
        <div class="site-header d-flex justify-content-between align-items-center">
            <h1>Create New Category</h1>
            <a href="{{ path('admin_categorie_cours_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>

        <div class="card">
            <div class="card-body">
                {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                    <div class="mb-3">
                        {{ form_label(form.nom, 'Name', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.nom) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Create Category
                    </button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
