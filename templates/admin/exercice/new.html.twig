{% extends 'admin/base.html.twig' %}

{% block title %}Nouvel exercice{% endblock %}

{% block content %}
    <div class="container-fluid">
        <h1 class="h3 mb-4 text-gray-800">Nouvel exercice</h1>

        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Formulaire de création</h6>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                {{ form_label(form.titre) }}
                                {{ form_widget(form.titre) }}
                                {{ form_errors(form.titre) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.niveauDifficulte) }}
                                {{ form_widget(form.niveauDifficulte) }}
                                {{ form_errors(form.niveauDifficulte) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.type) }}
                                {{ form_widget(form.type) }}
                                {{ form_errors(form.type) }}
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                {{ form_label(form.noteMinimale) }}
                                {{ form_widget(form.noteMinimale) }}
                                {{ form_errors(form.noteMinimale) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.tempsEstime) }}
                                {{ form_widget(form.tempsEstime) }}
                                {{ form_errors(form.tempsEstime) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.user) }}
                                {{ form_widget(form.user) }}
                                {{ form_errors(form.user) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.fichier_pdf) }}
                                {{ form_widget(form.fichier_pdf) }}
                                {{ form_errors(form.fichier_pdf) }}
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="{{ path('admin_exercice_index') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Retour à la liste
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-plus"></i> Créer l'exercice
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Prévisualisation du fichier PDF
        document.getElementById('{{ form.fichier_pdf.vars.id }}').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    // Vous pouvez ajouter ici une prévisualisation si nécessaire
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
{% endblock %}
