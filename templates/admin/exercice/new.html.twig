{% extends 'admin/base.html.twig' %}

{% block title %}Nouvel Exercice{% endblock %}

{% block content %}
    <div class="container-fluid">
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 mb-0 text-gray-800">Ajouter un exercice</h1>
            <a href="{{ path('admin_exercice_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
        </div>

        <div class="card shadow mb-4">
            <div class="card-body">
                {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.titre, 'Titre', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.titre) }}
                        </div>

                        <div class="col-md-6 mb-3">
                            {{ form_label(form.niveauDifficulte, 'Niveau de difficulté', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.niveauDifficulte, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.niveauDifficulte) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.noteMinimale, 'Note minimale', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.noteMinimale, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.noteMinimale) }}
                        </div>

                        <div class="col-md-6 mb-3">
                            {{ form_label(form.tempsEstime, 'Temps estimé (minutes)', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.tempsEstime, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.tempsEstime) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.type, 'Type d\'exercice', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.type, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.type) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.fichier_pdf, 'Fichier PDF', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.fichier_pdf, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.fichier_pdf) }}
                        <small class="text-muted">Format accepté : PDF</small>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Créer l'exercice
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Prévisualisation du fichier PDF
        document.getElementById('{{ form.fichier_pdf.vars.id }}').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file && file.type !== 'application/pdf') {
                alert('Veuillez sélectionner un fichier PDF');
                this.value = '';
            }
        });
    </script>
{% endblock %}
