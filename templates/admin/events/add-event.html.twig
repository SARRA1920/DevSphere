{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Evenements{% endblock %}

{% block content %}
    <div class="container-fluid">
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 mb-0 text-gray-800">Gestion des Evenements</h1>
        </div>

        <div class="card shadow mb-4">
            <div class="card-body">
                <div class="table-responsive">
                                    <h4 class="page-title">Add event</h4>
                                    {{ include('events/_form.html.twig') }}
                                    <a href="{{ path('app_events_index') }}">back to list</a>
                                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $('#dataTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/French.json"
                }
            });
        });
    </script>
{% endblock %}
