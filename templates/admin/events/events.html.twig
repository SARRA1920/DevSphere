{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Evenements{% endblock %}

{% block content %}
    <div class="container-fluid">
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 mb-0 text-gray-800">Gestion des Evenements</h1>
        </div>

        <div class="card shadow mb-4">
            <div class="card-body">
                <div class="table-responsive">
                                    <h4 class="page-title">Events List</h4>
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Id</th>
                                                <th>Titre</th>
                                                <th>Type</th>
                                                <th>Capacity</th>
                                                <th>Date</th>
                                                <th>Location</th>
                                                <th>actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        {% for event in events %}
                                            <tr>
                                                <td>{{ event.id }}</td>
                                                <td>{{ event.titre }}</td>
                                                <td>{{ event.type }}</td>
                                                <td>{{ event.capacity }}</td>
                                                <td>{{ event.date ? event.date|date('Y-m-d H:i:s') : '' }}</td>
                                                <td>{{ event.location }}</td>
                                                <td>
                                                    <a href="{{ path('app_events_edit', {'id': event.id}) }}">edit</a>
                                                    ||
                                                    <a href="{{ path('app_participation_index', {'id': event.id}) }}">participations</a>
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="7">no records found</td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>

                                    <a href="{{ path('app_events_new') }}">Create new</a>

                                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $('#dataTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/French.json"
                }
            });
        });
    </script>
{% endblock %}
