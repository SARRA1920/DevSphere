{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs{% endblock %}

{% block content %}
<!-- Users Management Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="section-title bg-white text-center text-primary px-3">Administration</h6>
            <h1 class="mb-5">Gestion des Utilisateurs</h1>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="row g-4">
            <div class="col-lg-12 wow fadeInUp" data-wow-delay="0.3s">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Image</th>
                                        <th>Nom</th>
                                        <th>Email</th>
                                        <th>Téléphone</th>
                                        <th>CIN</th>
                                        <th>Rôle</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for user in users %}
                                    <tr>
                                        <td>{{ user.id }}</td>
                                        <td>
                                            {% if user.image %}
                                                <img src="{{ asset('uploads/profile_images/' ~ user.image) }}" 
                                                     alt="Profile" 
                                                     class="rounded-circle"
                                                     style="width: 40px; height: 40px; object-fit: cover;">
                                            {% else %}
                                                <img src="{{ asset('img/default-avatar.png') }}" 
                                                     alt="Default Profile"
                                                     class="rounded-circle"
                                                     style="width: 40px; height: 40px; object-fit: cover;">
                                            {% endif %}
                                        </td>
                                        <td>{{ user.name }}</td>
                                        <td>{{ user.email }}</td>
                                        <td>{{ user.phone }}</td>
                                        <td>{{ user.cin }}</td>
                                        <td>
                                            <span class="badge bg-{{ user.role == 'admin' ? 'primary' : 'secondary' }}">
                                                {{ user.role|upper }}
                                            </span>
                                        </td>
                                        <td>
                                            {% if user != app.user %}
                                                <div class="btn-group" role="group">
                                                    <form method="post" action="{{ path('admin_users_toggle_admin', {'id': user.id}) }}" class="d-inline">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle-admin' ~ user.id) }}">
                                                        <button type="submit" class="btn btn-{{ user.role == 'admin' ? 'warning' : 'success' }} btn-sm">
                                                            {% if user.role == 'admin' %}
                                                                <i class="fas fa-user-minus"></i>
                                                            {% else %}
                                                                <i class="fas fa-user-plus"></i>
                                                            {% endif %}
                                                        </button>
                                                    </form>
                                                    
                                                    <form method="post" action="{{ path('admin_users_delete', {'id': user.id}) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                                        <button type="submit" class="btn btn-danger btn-sm">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            {% else %}
                                                <span class="badge bg-info">Vous-même</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="8" class="text-center">Aucun utilisateur trouvé</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Users Management End -->

<style>
.table th {
    background-color: #06BBCC;
    color: white;
}

.btn-group {
    gap: 0.5rem;
}

.badge {
    font-size: 0.875rem;
    padding: 0.5em 0.75em;
}

.card {
    border-radius: 15px;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
}

.table-responsive {
    border-radius: 15px;
}

.table {
    margin-bottom: 0;
}

.table td {
    vertical-align: middle;
}

.btn-sm {
    padding: 0.25rem 0.5rem;
}

.alert {
    border-radius: 10px;
    margin-bottom: 20px;
}

.section-title {
    position: relative;
    display: inline-block;
    text-transform: uppercase;
}

.section-title::before,
.section-title::after {
    position: absolute;
    content: "";
    width: 45px;
    height: 2px;
    top: 50%;
    background: #06BBCC;
}

.section-title::before {
    left: -55px;
}

.section-title::after {
    right: -55px;
}
</style>

<script>
// Auto-hide alerts after 5 seconds
document.addEventListener('DOMContentLoaded', function() {
    setTimeout(function() {
        const alerts = document.querySelectorAll('.alert');
        alerts.forEach(function(alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        });
    }, 5000);
});
</script>
{% endblock %}
