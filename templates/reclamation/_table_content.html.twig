{% for reclamation in reclamations %}
    <tr>
        <td>{{ reclamation.id }}</td>
        <td>{{ reclamation.type }}</td>
        <td>{{ reclamation.date ? reclamation.date|date('Y-m-d H:i:s') : '' }}</td>
        <td>{{ reclamation.reclamation }}</td>
        {% if is_granted('ROLE_ADMIN') %}
            <td>{{ reclamation.user ? reclamation.user.email : '' }}</td>
        {% endif %}
        <td>
            <div class="btn-group">
                <a href="{{ path('app_reclamation_show', {'id': reclamation.id}) }}" class="btn btn-sm btn-info" title="Voir">
                    <i class="fas fa-eye"></i>
                </a>
                {% if is_granted('ROLE_ADMIN') or app.user and app.user.id == reclamation.user.id %}
                    <a href="{{ path('app_reclamation_edit', {'id': reclamation.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_reponse_new', {'id': reclamation.id}) }}" class="btn btn-sm btn-success" title="Répondre">
                        <i class="fas fa-reply"></i>
                    </a>
                {% endif %}
            </div>
        </td>
    </tr>
{% else %}
    <tr>
        <td colspan="{% if is_granted('ROLE_ADMIN') %}6{% else %}5{% endif %}" class="text-center">Aucune réclamation trouvée</td>
    </tr>
{% endfor %}
