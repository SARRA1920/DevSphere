{% extends 'base.html.twig' %}

{% block title %}Détails de la Réclamation{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h1 class="h3 mb-0">Détails de la Réclamation</h1>
                    <div>
                        <a href="{{ path('app_reclamation_edit', {'id': reclamation.id}) }}" class="btn btn-warning btn-sm">
                            <i class="fas fa-edit"></i> Modifier
                        </a>
                        {% if not reclamation.reponse %}
                            <a href="{{ path('app_reponse_new', {'id': reclamation.id}) }}" class="btn btn-success btn-sm ms-2">
                                <i class="fas fa-reply"></i> Répondre
                            </a>
                        {% endif %}
                    </div>
                </div>
                <div class="card-body">
                    <table class="table">
                        <tbody>
                            <tr>
                                <th>ID</th>
                                <td>{{ reclamation.id }}</td>
                            </tr>
                            <tr>
                                <th>Type</th>
                                <td>{{ reclamation.type }}</td>
                            </tr>
                            <tr>
                                <th>Date</th>
                                <td>{{ reclamation.date ? reclamation.date|date('Y-m-d H:i:s') : '' }}</td>
                            </tr>
                            <tr>
                                <th>Réclamation</th>
                                <td>{{ reclamation.reclamation }}</td>
                            </tr>
                            <tr>
                                <th>Statut</th>
                                <td>
                                    {% if reclamation.reponse %}
                                        <span class="badge bg-success">Répondu</span>
                                    {% else %}
                                        <span class="badge bg-warning">En attente</span>
                                    {% endif %}
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    {% if reclamation.reponse %}
                        <div class="mt-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h4>Réponse</h4>
                                <a href="{{ path('app_reponse_edit', {'id': reclamation.reponse.id}) }}" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i> Modifier la réponse
                                </a>
                            </div>
                            <div class="alert alert-info">
                                <p class="mb-1"><strong>Date :</strong> {{ reclamation.reponse.date|date('Y-m-d H:i:s') }}</p>
                                <p class="mb-0">{{ reclamation.reponse.reponse }}</p>
                            </div>
                        </div>
                    {% endif %}

                    <div class="d-flex justify-content-between mt-4">
                        <a href="{{ path('app_reclamation_index') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Retour
                        </a>
                        
                        <form method="post" action="{{ path('app_reclamation_delete', {'id': reclamation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette réclamation ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reclamation.id) }}">
                            <button class="btn btn-danger">
                                <i class="fas fa-trash"></i> Supprimer
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
