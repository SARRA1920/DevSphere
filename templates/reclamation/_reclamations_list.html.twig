{% for reclamation in reclamations %}
    <tr>
        <td>{{ reclamation.id }}</td>
        <td>{{ reclamation.type }}</td>
        <td>{{ reclamation.date ? reclamation.date|date('Y-m-d H:i:s') : '' }}</td>
        <td>{{ reclamation.reclamation }}</td>
        <td>{{ reclamation.user ? reclamation.user.email : '' }}</td>
        <td>
            <a href="{{ path('app_reclamation_show', {'id': reclamation.id}) }}" class="btn btn-info btn-sm">
                <i class="fas fa-eye"></i>
            </a>
            <a href="{{ path('app_reclamation_edit', {'id': reclamation.id}) }}" class="btn btn-warning btn-sm">
                <i class="fas fa-edit"></i>
            </a>
        </td>
    </tr>
{% else %}
    <tr>
        <td colspan="6" class="text-center">Aucune réclamation trouvée</td>
    </tr>
{% endfor %}
