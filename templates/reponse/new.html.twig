{% extends 'base.html.twig' %}

{% block title %}Répondre à la Réclamation{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header bg-info text-white">
                    <h2 class="h4 mb-0">Réclamation #{{ reclamation.id }}</h2>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6 class="fw-bold">Type:</h6>
                        <p>{{ reclamation.type }}</p>
                    </div>
                    <div class="mb-3">
                        <h6 class="fw-bold">Date:</h6>
                        <p>{{ reclamation.date|date('Y-m-d H:i:s') }}</p>
                    </div>
                    <div>
                        <h6 class="fw-bold">Message:</h6>
                        <p>{{ reclamation.reclamation }}</p>
                    </div>
                </div>
            </div>

            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="h4 mb-0">Votre Réponse</h3>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                    
                    <div class="mb-3">
                        {{ form_widget(form.reponse) }}
                        {{ form_errors(form.reponse) }}
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="{{ path('app_reclamation_show', {'id': reclamation.id}) }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Retour
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-paper-plane"></i> Envoyer la réponse
                        </button>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
