{% extends 'base.html.twig' %}

{% block title %}Modifier un Mot Inapproprié - DevSphere{% endblock %}

{% block content %}
    <div class="container-xxl py-5">
        <div class="container">
            <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
                <h6 class="section-title bg-white text-center text-primary px-3">Administration</h6>
                <h1 class="mb-5">Modifier un Mot Inapproprié</h1>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-6">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {% endfor %}
                    {% endfor %}

                    <div class="card">
                        <div class="card-body">
                            <form method="post">
                                <div class="mb-3">
                                    <label for="word" class="form-label">Mot</label>
                                    <input type="text" class="form-control" id="word" name="word" 
                                           value="{{ bad_word.word }}" required>
                                </div>

                                <div class="mb-3">
                                    <label for="severity" class="form-label">Sévérité (1-10)</label>
                                    <input type="range" class="form-range" id="severity" name="severity" 
                                           min="1" max="10" value="{{ bad_word.severity }}" 
                                           oninput="severityValue.textContent = this.value">
                                    <div class="text-center">
                                        Niveau: <span id="severityValue">{{ bad_word.severity }}</span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="is_active" 
                                               name="is_active" value="1" {% if bad_word.isActive %}checked{% endif %}>
                                        <label class="form-check-label" for="is_active">Actif</label>
                                    </div>
                                </div>

                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save"></i> Enregistrer les modifications
                                    </button>
                                    <a href="{{ path('app_bad_word_index') }}" class="btn btn-secondary">
                                        <i class="fas fa-arrow-left"></i> Retour à la liste
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
