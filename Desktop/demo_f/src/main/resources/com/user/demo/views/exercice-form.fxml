<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.user.demo.controller.ExerciceFormController"
            stylesheets="@../styles/styles.css">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <top>
        <Label text="Modifier l'exercice" styleClass="title-label">
            <padding>
                <Insets bottom="20"/>
            </padding>
            <font>
                <Font name="System Bold" size="18"/>
            </font>
        </Label>
    </top>
    
    <center>
        <VBox spacing="15">
            <GridPane hgap="10" vgap="15">
                <columnConstraints>
                    <ColumnConstraints minWidth="100" prefWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS" prefWidth="300"/>
                </columnConstraints>
                
                <!-- Titre -->
                <Label text="Titre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="titreField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                
                <!-- Type -->
                <Label text="Type:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="typeComboBox" prefWidth="300" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                
                <!-- Niveau -->
                <Label text="Niveau:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="niveauComboBox" prefWidth="300" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                
                <!-- Description -->
                <Label text="Description:" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.valignment="TOP">
                    <GridPane.margin>
                        <Insets top="5"/>
                    </GridPane.margin>
                </Label>
                <TextArea fx:id="descriptionArea" prefHeight="100" wrapText="true" 
                          GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>
    </center>
    
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="20" right="0" bottom="0" left="0"/>
            </padding>
            <Button text="Annuler" onAction="#handleCancel" styleClass="button-secondary"/>
            <Button text="Enregistrer" onAction="#handleOk" styleClass="button-primary"/>
        </HBox>
    </bottom>
</BorderPane> 