<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>
<?import de.jensd.fx.glyphs.fontawesome.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.user.demo.controller.AdminReclamationController"
      spacing="20" styleClass="content-panel">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30" />
    </padding>

    <!-- Header Section with Enhanced Styling -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <HBox alignment="CENTER_LEFT" styleClass="title-container">
            <Pane styleClass="title-accent" prefWidth="5" prefHeight="30"/>
            <Label text="Reclamation Management" styleClass="view-title">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
                <padding>
                    <Insets left="15" />
                </padding>
            </Label>
        </HBox>
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER" styleClass="stats-pill">
            <padding>
                <Insets top="8" right="18" bottom="8" left="18" />
            </padding>
            <FontAwesomeIconView glyphName="FILE_TEXT" size="18" styleClass="stats-icon" />
            <Label fx:id="totalRecordsLabel" text="Total: 0 records" styleClass="total-records">
                <padding>
                    <Insets left="10" />
                </padding>
            </Label>
        </HBox>
    </HBox>

    <!-- Search Section with Glass Morphism Effect -->
    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="search-container">
        <padding>
            <Insets top="18" right="25" bottom="18" left="25" />
        </padding>
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="12" styleClass="search-field-container">
            <FontAwesomeIconView glyphName="SEARCH" size="16" styleClass="search-icon" />
            <TextField fx:id="searchField" promptText="Search reclamations..." HBox.hgrow="ALWAYS" styleClass="search-field" />
        </HBox>
        <Separator orientation="VERTICAL" styleClass="filter-separator"/>
        <HBox alignment="CENTER" spacing="10">
            <FontAwesomeIconView glyphName="FILTER" size="16" styleClass="filter-icon" />
            <ComboBox fx:id="statusFilter" promptText="Status" styleClass="filter-combo" />
        </HBox>
        <Separator orientation="VERTICAL" styleClass="filter-separator"/>
        <HBox alignment="CENTER" spacing="10">
            <FontAwesomeIconView glyphName="TAGS" size="16" styleClass="filter-icon" />
            <ComboBox fx:id="typeFilter" promptText="Type" styleClass="filter-combo" />
        </HBox>
        <Button text="Search" onAction="#handleSearch" styleClass="search-button">
            <graphic>
                <FontAwesomeIconView glyphName="SEARCH" size="16" />
            </graphic>
        </Button>
    </HBox>

    <!-- Cards Container with Enhanced Styling -->
    <StackPane VBox.vgrow="ALWAYS" styleClass="cards-stack-container">
        <ScrollPane fitToWidth="true" styleClass="card-scroll-pane">
            <FlowPane fx:id="reclamationCards" hgap="25" vgap="25" styleClass="admin-cards-container">
                <padding>
                    <Insets top="10" right="10" bottom="20" left="10" />
                </padding>
                <!-- Cards will be added dynamically -->
            </FlowPane>
        </ScrollPane>
        
        <!-- Empty State -->
        <VBox fx:id="emptyState" alignment="CENTER" spacing="15" styleClass="empty-state-container" visible="false" managed="false">
            <FontAwesomeIconView glyphName="INBOX" size="48" styleClass="empty-state-icon"/>
            <Label text="No reclamations found" styleClass="empty-state-text"/>
            <Label text="Try adjusting your search filters" styleClass="empty-state-subtext"/>
            <Button text="Clear Filters" onAction="#handleClearFilters" styleClass="empty-state-button">
                <graphic>
                    <FontAwesomeIconView glyphName="REFRESH" size="14"/>
                </graphic>
            </Button>
        </VBox>
    </StackPane>

    <!-- Modern Pagination -->
    <HBox alignment="CENTER">
        <Pagination fx:id="pagination" styleClass="modern-pagination" />
    </HBox>
</VBox>