<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/17.0.9" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.InscriptionFormController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>

    <Label fx:id="formTitleLabel" text="Ajouter une Inscription" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nom:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nomField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        
        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        
        <Label text="Téléphone:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="telephoneField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Cours:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <ComboBox fx:id="coursComboBox" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Statut:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <ComboBox fx:id="statutComboBox" GridPane.columnIndex="1" GridPane.rowIndex="4">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="En attente"/>
                    <String fx:value="Confirmée"/>
                    <String fx:value="Annulée"/>
                </FXCollections>
            </items>
        </ComboBox>
        
        <Label text="Date d'inscription:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <DatePicker fx:id="dateInscriptionPicker" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20px 0 0 0;">
        <Button fx:id="actionButton" text="Ajouter" onAction="#handleAction"/>
        <Button text="Annuler" onAction="#handleCancel"/>
    </HBox>
</VBox> 