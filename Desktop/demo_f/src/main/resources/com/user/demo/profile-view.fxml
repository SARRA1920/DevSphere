<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.paint.Color?>
<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.user.demo.controller.ProfileController"
            prefHeight="600.0" prefWidth="800.0"
            stylesheets="@styles.css">
    
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="profile-header">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>
            
            <Label text="User Profile" styleClass="page-title">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>
        </HBox>
    </top>
    
    <center>
        <ScrollPane fitToWidth="true" styleClass="transparent-bg">
            <VBox spacing="30" styleClass="profile-container">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20" />
                </padding>
                
                <!-- User profile card -->
                <HBox spacing="20" styleClass="profile-card">
                    <VBox alignment="CENTER" spacing="10" HBox.hgrow="NEVER">
                        <ImageView fx:id="profileImage" fitWidth="150" fitHeight="150" preserveRatio="true" styleClass="profile-image">
                            <Image url="@images/default.jpg"/>
                        </ImageView>
                        <Button fx:id="changeImageButton" text="Change Image" onAction="#handleChangeImage" styleClass="secondary-button">
                            <graphic>
                                <FontAwesomeIconView glyphName="CAMERA" size="14" />
                            </graphic>
                        </Button>
                    </VBox>
                    
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label fx:id="nameLabel" text="User Full Name" styleClass="profile-name">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <FontAwesomeIconView glyphName="ENVELOPE" size="14" styleClass="profile-icon"/>
                            <Label fx:id="emailLabel" text="user@example.com" styleClass="profile-info"/>
                        </HBox>
                        
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <FontAwesomeIconView glyphName="PHONE" size="14" styleClass="profile-icon"/>
                            <Label fx:id="phoneLabel" text="12345678" styleClass="profile-info"/>
                        </HBox>
                        
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <FontAwesomeIconView glyphName="ID_CARD" size="14" styleClass="profile-icon"/>
                            <Label fx:id="cinLabel" text="12345678" styleClass="profile-info"/>
                        </HBox>
                        
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <FontAwesomeIconView glyphName="USER" size="14" styleClass="profile-icon"/>
                            <Label fx:id="roleLabel" text="User" styleClass="profile-info"/>
                        </HBox>
                    </VBox>
                </HBox>
                
                <!-- Edit profile section -->
                <VBox spacing="20" styleClass="edit-profile-section">
                    <Label text="Edit Profile" styleClass="section-title">
                        <font>
                            <Font name="System Bold" size="18.0" />
                        </font>
                    </Label>
                    
                    <Label fx:id="errorLabel" text="An error occurred." 
                           styleClass="error-label" visible="false" managed="false" />
                    
                    <GridPane hgap="20" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="100" prefWidth="150" maxWidth="200" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="200" />
                        </columnConstraints>
                        
                        <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="input-label"/>
                        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="input-field"/>
                        
                        <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="input-label"/>
                        <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="input-field"/>
                        
                        <Label text="Phone:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="input-label"/>
                        <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="input-field"/>
                        
                        <Label text="CIN:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="input-label"/>
                        <TextField fx:id="cinField" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="input-field"/>
                    </GridPane>
                    
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button fx:id="saveButton" text="Save Changes" onAction="#handleSaveChanges" styleClass="primary-button">
                            <graphic>
                                <FontAwesomeIconView glyphName="SAVE" size="14" />
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
                
                <!-- Change password section -->
                <VBox spacing="20" styleClass="change-password-section">
                    <Label text="Change Password" styleClass="section-title">
                        <font>
                            <Font name="System Bold" size="18.0" />
                        </font>
                    </Label>
                    
                    <Label fx:id="passwordErrorLabel" text="Passwords don't match." 
                           styleClass="error-label" visible="false" managed="false" />
                    
                    <GridPane hgap="20" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="100" prefWidth="150" maxWidth="200" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="200" />
                        </columnConstraints>
                        
                        <Label text="Current Password:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="input-label"/>
                        <PasswordField fx:id="currentPasswordField" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="input-field"/>
                        
                        <Label text="New Password:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="input-label"/>
                        <PasswordField fx:id="newPasswordField" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="input-field"/>
                        
                        <Label text="Confirm Password:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="input-label"/>
                        <PasswordField fx:id="confirmPasswordField" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="input-field"/>
                    </GridPane>
                    
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button fx:id="changePasswordButton" text="Change Password" onAction="#handleChangePassword" styleClass="primary-button">
                            <graphic>
                                <FontAwesomeIconView glyphName="LOCK" size="14" />
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>