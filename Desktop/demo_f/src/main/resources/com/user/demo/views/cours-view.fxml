<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.user.demo.controller.CoursViewController"
      spacing="20"
      style="-fx-background-color: #f5f5f5;">

    <stylesheets>
        <URL value="@/com/user/demo/styles/cours.css"/>
    </stylesheets>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Titre et bouton d'ajout -->
    <HBox alignment="CENTER" spacing="20">
        <Label text="Gestion des Cours" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Button text="+ Ajouter un cours" 
                fx:id="addCourseButton" 
                onAction="#handleAddCourse" 
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 15;"/>
    </HBox>

    <!-- Barre de filtres -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" 
                  promptText="Rechercher des cours..."
                  HBox.hgrow="ALWAYS"/>
        
        <ComboBox fx:id="categoryFilter" 
                  prefWidth="200"/>
        
        <Button text="Effacer les filtres"
                onAction="#handleClearFilters"
                styleClass="button-secondary"/>
                
        <Button text="+ Nouveau Cours" 
                onAction="#handleAddCourse"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Conteneur de cours -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="coursContainer" 
                  hgap="20" 
                  vgap="20">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </FlowPane>
    </ScrollPane>

</VBox> 