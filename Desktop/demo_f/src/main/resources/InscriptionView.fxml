<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox spacing="20" xmlns:fx="http://javafx.com/fxml" fx:controller="com.user.demo.controller.InscriptionController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox spacing="10">
        <Label text="Inscription aux Cours" styleClass="page-title"/>
        
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Rechercher des cours..." HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="categoryFilter" promptText="Toutes les catégories" prefWidth="150"/>
            <ComboBox fx:id="statusFilter" promptText="Tous les statuts" prefWidth="150"/>
            <Button text="Effacer les filtres" onAction="#handleClearFilters" styleClass="button-secondary"/>
        </HBox>
    </VBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="edge-to-edge">
        <FlowPane fx:id="coursContainer" hgap="20" vgap="20">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </FlowPane>
    </ScrollPane>

    <stylesheets>
        <URL value="@/styles.css"/>
    </stylesheets>
</VBox> 