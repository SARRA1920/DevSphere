<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.user.demo.controller.WebcamTestController"
      spacing="10"
      style="-fx-background-color: #1a1a1a;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Zone de prévisualisation de la webcam -->
    <ImageView fx:id="webcamView"
               fitWidth="640"
               fitHeight="480"
               preserveRatio="true"/>

    <!-- Boutons de contrôle -->
    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="startButton"
                text="Démarrer la caméra"
                onAction="#handleStartCamera"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
        
        <Button fx:id="stopButton"
                text="Arrêter la caméra"
                onAction="#handleStopCamera"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
    </HBox>

</VBox> 