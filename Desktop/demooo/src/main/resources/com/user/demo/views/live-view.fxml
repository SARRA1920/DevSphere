<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.user.demo.controller.LiveViewController"
      spacing="10"
      style="-fx-background-color: #1a1a1a;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- En-tête -->
    <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
        <Label fx:id="courseTitleLabel" 
               style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="viewersCountLabel" 
               style="-fx-text-fill: #ecf0f1;"/>
        <Button fx:id="endLiveButton" 
                text="Terminer le live" 
                onAction="#handleEndLive"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
    </HBox>

    <!-- Zone principale -->
    <HBox VBox.vgrow="ALWAYS" spacing="10">
        <!-- Zone de streaming -->
        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <WebView fx:id="streamView" VBox.vgrow="ALWAYS"/>
            
            <!-- Contrôles de streaming -->
            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <Button fx:id="toggleMicButton" 
                        text="Micro" 
                        onAction="#handleToggleMic"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                <Button fx:id="toggleCameraButton" 
                        text="Caméra" 
                        onAction="#handleToggleCamera"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                <Button fx:id="shareScreenButton" 
                        text="Partager l'écran" 
                        onAction="#handleShareScreen"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
            </HBox>
        </VBox>

        <!-- Chat -->
        <VBox minWidth="300" maxWidth="300" style="-fx-background-color: #2c3e50;">
            <Label text="Discussion en direct" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 10 5 10;"/>
            
            <ListView fx:id="chatListView" 
                     VBox.vgrow="ALWAYS"
                     style="-fx-background-color: #34495e; -fx-control-inner-background: #34495e; -fx-text-fill: white;"/>
            
            <HBox spacing="5" style="-fx-padding: 10;">
                <TextField fx:id="messageField" 
                          HBox.hgrow="ALWAYS"
                          promptText="Écrivez un message..."
                          onAction="#handleSendMessage"
                          style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
                <Button fx:id="sendButton" 
                        text="Envoyer" 
                        onAction="#handleSendMessage"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </HBox>
</VBox> 