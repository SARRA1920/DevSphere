<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="com.user.demo.controller.ListeTentativesController"
      spacing="10" styleClass="content-panel"
      stylesheets="@../styles/styles.css">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- En-tête avec titre et boutons -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <children>
            <Label text="Liste des Tentatives" styleClass="title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="exportButton" text="Exporter Tout" onAction="#handleExport"/>
            <Button fx:id="exportReponsesButton" text="Exporter Réponses" onAction="#handleExportReponses"/>
        </children>
    </HBox>
    
    <!-- Barre de recherche et filtres -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <children>
            <TextField fx:id="searchField" promptText="Rechercher..." prefWidth="300"/>
            <ComboBox fx:id="filterComboBox" prefWidth="150" promptText="Filtrer par statut"/>
            <Button text="Effacer les filtres" onAction="#handleClearFilters"/>
        </children>
    </HBox>

    <!-- ScrollPane contenant les cartes -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="edge-to-edge">
        <FlowPane fx:id="cardsContainer" hgap="10" vgap="10" styleClass="cards-container">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </FlowPane>
    </ScrollPane>
    
    <!-- Barre de statut -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <children>
            <Label fx:id="statusLabel" text="Total des tentatives : 0"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Actualiser" onAction="#handleRefresh"/>
        </children>
    </HBox>
</VBox> 