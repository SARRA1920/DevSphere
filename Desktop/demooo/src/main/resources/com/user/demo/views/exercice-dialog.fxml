<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.user.demo.controller.ExerciceDialogController"
            prefWidth="500.0"
            prefHeight="600.0">
    <content>
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="100" prefWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Titre -->
                <Label text="Titre :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="titreField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <!-- Niveau de difficulté -->
                <Label text="Niveau :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="niveauCombo" prefWidth="200" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <!-- Note minimale -->
                <Label text="Note minimale :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="noteMinimaleField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <!-- Temps estimé -->
                <Label text="Temps estimé (min) :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="tempsEstimeField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <!-- Type -->
                <Label text="Type :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <ComboBox fx:id="typeCombo" prefWidth="200" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <!-- Type d'exercice -->
                <Label text="Type d'exercice :" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <ComboBox fx:id="typeExerciceCombo" prefWidth="200" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <!-- Fichier PDF -->
                <Label text="Fichier PDF :" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <HBox spacing="10" GridPane.rowIndex="6" GridPane.columnIndex="1">
                    <TextField fx:id="fichierPdfField" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="choosePdfButton" text="Parcourir" onAction="#handleChooseFile"/>
                </HBox>

                <!-- Solution -->
                <Label text="Solution :" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <TextArea fx:id="solutionArea" prefRowCount="3" wrapText="true" 
                         GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                <!-- Critères d'évaluation -->
                <Label text="Critères :" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                <TextArea fx:id="criteresArea" prefRowCount="3" wrapText="true"
                         GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                <!-- Description -->
                <Label text="Description :" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                <TextArea fx:id="descriptionArea" prefRowCount="3" wrapText="true"
                         GridPane.rowIndex="9" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>
    </content>
</DialogPane> 