<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.ChatbotController"
      spacing="10"
      style="-fx-background-color: white;">
    
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <ScrollPane fx:id="chatScrollPane" 
                VBox.vgrow="ALWAYS" 
                fitToWidth="true"
                style="-fx-background-color: transparent;">
        <VBox fx:id="chatBox" spacing="10"/>
    </ScrollPane>

    <HBox spacing="10" alignment="CENTER">
        <TextArea fx:id="messageInput"
                  HBox.hgrow="ALWAYS"
                  promptText="Posez votre question ici..."
                  wrapText="true"
                  prefRowCount="2"
                  maxHeight="100"
                  style="-fx-background-color: #F0F0F0; -fx-background-radius: 5;"/>
                  
        <JFXButton fx:id="sendButton"
                   text="Envoyer"
                   style="-fx-background-color: #2196F3; -fx-text-fill: white;">
            <graphic>
                <FontAwesomeIconView glyphName="SEND" fill="white"/>
            </graphic>
        </JFXButton>
    </HBox>
</VBox> 