<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/17.0.9" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.CoursFormController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>

    <Label fx:id="formTitleLabel" text="Ajouter un Cours" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Titre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="titreField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextArea fx:id="descriptionArea" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Durée (heures):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="dureeField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Niveau:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <ComboBox fx:id="niveauComboBox" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Débutant"/>
                    <String fx:value="Intermédiaire"/>
                    <String fx:value="Avancé"/>
                </FXCollections>
            </items>
        </ComboBox>

        <Label text="Catégorie:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <ComboBox fx:id="categorieComboBox" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        
        <Label text="Instructeur:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextField fx:id="instructeurField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        
        <Label text="Image:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="6">
            <TextField fx:id="imageField" HBox.hgrow="ALWAYS"/>
            <Button text="Parcourir" onAction="#handleImageBrowse"/>
        </HBox>
        
        <Label text="PDF:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
        <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="7">
            <TextField fx:id="pdfField" HBox.hgrow="ALWAYS"/>
            <Button text="Parcourir" onAction="#handlePdfBrowse"/>
        </HBox>
    </GridPane>

    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20px 0 0 0;">
        <Button fx:id="actionButton" text="Ajouter" onAction="#handleAction"/>
        <Button text="Annuler" onAction="#handleCancel"/>
    </HBox>
</VBox> 