<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/17.0.9" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.CategorieCoursFormController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>

    <Label fx:id="formTitleLabel" text="Ajouter une Catégorie de Cours" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nom:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nomField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextArea fx:id="descriptionArea" prefHeight="100" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        
        <Label text="Niveau:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="niveauComboBox" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Débutant"/>
                    <String fx:value="Intermédiaire"/>
                    <String fx:value="Avancé"/>
                </FXCollections>
            </items>
        </ComboBox>
    </GridPane>

    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20px 0 0 0;">
        <Button fx:id="actionButton" text="Ajouter" onAction="#handleAction"/>
        <Button text="Annuler" onAction="#handleCancel"/>
    </HBox>
</VBox> 